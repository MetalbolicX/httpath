{
  "name": "@metalbolicx/httpath-rescript",
  "version": "0.1.0",
  "description": "ReScript rewrite of httpath",
  "type": "module",
  "bin": {
    "httpath": "./dist/httpath.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "bin.mjs",
    "rescript.json",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rescript && rolldown -c rolldown.config.mjs",
    "dev": "rescript build -watch",
    "start": "node bin.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm test",
    "test:unit": "pnpm run build && node_modules/.bin/retest 'tests/unit/*.res.mjs' && node --env-file=retest.env.js tests/unit/restart_test.mjs",
    "test:integration": "node --test tests/integration/ws_hub.test.js tests/integration/entrypoint.test.js",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:integration"
  },
  "devDependencies": {
    "@rescript/runtime": "^12.3.0",
    "rescript": "^12.3.0",
    "rescript-test": "8.0.1",
    "rolldown": "^1.2.2"
  }
}
