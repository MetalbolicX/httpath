{
  "name": "@metalbolicx/httpath",
  "description": "A lightweight, feature-rich static file server similar to Python's `python -m http.server` but with only the standard Deno modules.",
  "version": "1.0.0",
  "license": "MIT",
  "exports": "./httpath.ts",
  "tasks": {
    "dev": "deno run --env-file=.env -RN --allow-run --allow-env --sloppy-imports httpath.ts",
    "test": "deno test tests/",
    "integration-test": "deno test --allow-write --allow-run --allow-read --allow-env --allow-net integration/",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.29",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing/mock": "jsr:@std/testing@^1.0.18/mock"
  }
}
